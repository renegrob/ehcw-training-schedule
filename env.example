# Copy this file to .env and fill in your own values.
# .env is gitignored - never commit your actual values.

# Deploy safety guard (used by deploy.sh and create-bucket.sh). Set this to the
# WORKLOAD account id you deploy into. In an AWS Organizations setup you log in
# through the management account but `export AWS_PROFILE=workload` to act in the
# workload account; if the profile is unset/expired the caller identity would be
# the management account. When EXPECTED_ACCOUNT_ID is set, the scripts abort on
# any mismatch instead of creating resources in the wrong account. Unset = guard
# off (a warning is printed).
# EXPECTED_ACCOUNT_ID=123456789012

# SSM parameter holding the Google service account key. Defaults to the
# same parameter used by the aws-ical-sync project (shared secret, same
# Google service account, already shared with the target calendars).
SSM_PARAM_NAME=/ical-sync/google-service-account

# AWS region the SSM parameter lives in.
AWS_REGION=eu-central-2

# Where the sync remembers what it created (so events you delete in Google
# Calendar are not re-added). A local path locally; on Lambda point it at S3,
# since the local filesystem does not persist between invocations. The Lambda
# role then needs s3:GetObject / s3:PutObject on that key.
#   local:  SYNC_STATE_URI=sync-state.json   (default)
#   lambda: SYNC_STATE_URI=s3://my-bucket/ehcw-trainings/sync-state.json
SYNC_STATE_URI=sync-state.json

# Lambda only: where PDFs are fetched to and found at runtime. The package dir
# under /var/task is read-only on Lambda, so deploy.sh points this at /tmp.
# Leave unset locally (defaults to the downloads/ dir next to the code).
#   lambda: DOWNLOAD_DIR=/tmp/downloads
# DOWNLOAD_DIR=/tmp/downloads

# Lambda only: S3 prefix holding the season Spielplan PDFs. The handler pulls
# every *.pdf under this prefix into DOWNLOAD_DIR at the start of each run.
# Leave unset locally (Spielplans are read straight from downloads/).
#   lambda: SPIELPLAN_S3_PREFIX=s3://my-bucket/spielplan/
# SPIELPLAN_S3_PREFIX=s3://my-bucket/spielplan/
